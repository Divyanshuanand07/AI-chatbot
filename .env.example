# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Never commit the real `.env`.
# In production these are injected as real environment variables.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-this-default-is-long-enough-for-hs256
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json  (use json in production)

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://ops_ai:ops_ai_pw@localhost:5432/ops_ai

# ---------------------------------------------------------------------------
# Cache / session state. Leave blank to fall back to in-process memory.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# LLM
#   LLM_PROVIDER=anthropic -> live model calls (needs ANTHROPIC_API_KEY)
#   LLM_PROVIDER=stub      -> deterministic offline driver, no network, no cost
# ---------------------------------------------------------------------------
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
LLM_EFFORT=high             # low | medium | high | xhigh | max
LLM_THINKING=adaptive       # adaptive | disabled
LLM_REFUSAL_FALLBACK=True
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ITERATIONS=6
LLM_HISTORY_TURNS=8

# ---------------------------------------------------------------------------
# Tool execution budgets
# ---------------------------------------------------------------------------
TOOL_TIMEOUT_SECONDS=8
TOOL_MAX_PARALLEL=6
TOOL_CACHE_ENABLED=True

# ---------------------------------------------------------------------------
# Knowledge base / RAG
#   hashing -> deterministic local embeddings, no network (default)
#   voyage  -> Voyage AI embeddings (needs VOYAGE_API_KEY)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SIMILARITY=0.25

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
THROTTLE_AI_QUERY=30/min
THROTTLE_READ_API=600/min

# ---------------------------------------------------------------------------
# Operational SLA thresholds used by the blocker rule engine.
# Tune these without touching code.
# ---------------------------------------------------------------------------
SLA_STALE_EVENT_DAYS=3
SLA_DOCS_VERIFICATION_DAYS=2
SLA_PAYMENT_PENDING_DAYS=2
SLA_FINANCE_REVIEW_DAYS=3
SLA_RC_TRANSFER_DAYS=21
SLA_DELIVERY_ATTEMPT_LIMIT=2
SLA_REFUND_DAYS=7

# How long a customer may take to upload documents before it is a blocker
SLA_DOCS_COLLECTION_DAYS=3
